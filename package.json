  "private": true,
  "type": "module",
  "homepage": "https://punkypi.github.io/stop_and_search",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "bake": "node scripts/bake-data.mjs",
