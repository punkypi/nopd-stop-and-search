    "build:nobake": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.43"
